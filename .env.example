# Database URL for Prisma SQLite
DATABASE_URL="file:../data/wildtrace.db"

# OpenRouter Configuration (Primary External Multimodal AI Provider)
# Obtain an API key from https://openrouter.ai/keys (Keys are strictly server-side and never exposed to clients)
OPENROUTER_API_KEY=""

# Configurable OpenRouter Vision Model (must support multimodal image inputs)
# Evaluated and verified models:
# - "google/gemini-2.5-flash" (Default: Fast ~5s wall-clock latency, recommended for interactive demo)
# - "qwen/qwen2.5-vl-72b-instruct" (Open-Weight Flagship: Qwen Research License, ~25s latency)
# - "qwen/qwen3-vl-8b-instruct" (Open-Weight Lightweight: Qwen License, 262k context, ~23s latency)
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Optional Request Timeout in milliseconds (default: 35000ms for large open-weight vision models)
OPENROUTER_TIMEOUT_MS=35000

# Optional Secondary Hugging Face Token (backward compatibility fallback)
HUGGINGFACE_API_KEY=""

# Port Configuration
PORT=3000
